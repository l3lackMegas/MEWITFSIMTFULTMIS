  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:bun": "bun test ./test/bun.integration.ts",
    "check": "npm run typecheck && npm test && npm run build",
